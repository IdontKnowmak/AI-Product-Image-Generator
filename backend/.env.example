# Database (Neon connection string in production, or local docker-compose postgres)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/product_image_gen

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gemini (Google AI Studio) - get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudinary (free tier) - https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS - your frontend URL
FRONTEND_ORIGIN=http://localhost:3000
